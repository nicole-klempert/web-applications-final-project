# .env.example - Copy this file to .env and fill in your credentials.

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/your_database_name

# 32-byte AES-256-GCM encryption key in Hex format (64 characters)
# Generate a new one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_character_hex_key

# Secret salt for generating blind indexes (HMAC-SHA256)
# Generate a new one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BLIND_INDEX_SALT=your_blind_index_salt
